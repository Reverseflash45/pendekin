# Supabase — hanya dipakai di server (route handler & server component),
# jadi tidak perlu awalan NEXT_PUBLIC_. Kunci publishable/anon sudah cukup:
# semua penulisan lewat fungsi SQL di supabase.sql.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=sb_publishable_xxx

# Opsional. Bila diisi, setiap URL dicek ke Google Safe Browsing sebelum
# dipendekkan (gratis: https://developers.google.com/safe-browsing).
GOOGLE_SAFE_BROWSING_KEY=
